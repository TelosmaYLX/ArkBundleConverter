<Window x:Class="ArkBundleConverterGUI_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArkBundleConverterGUI_WPF"
        mc:Ignorable="d"
        WindowStyle="None" 
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Height="620" Width="625" MinHeight="400" MinWidth="450" 
        Background="Transparent"
        FontFamily="Segoe UI" 
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 调色板 -->
        <Color x:Key="PrimaryColor">#FF1E293B</Color>
        <Color x:Key="AccentColor">#FF3B82F6</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE2E8F0"/>

        <!-- 图标路径数据 -->
        <Geometry x:Key="IconMinimize">M 0,7 L 10,7</Geometry>
        <Geometry x:Key="IconMaximize">M 1,1 L 9,1 L 9,9 L 1,9 Z</Geometry>
        <!-- 新增：还原图标 (两个重叠的方框) -->
        <Geometry x:Key="IconRestore">M 1,3 L 1,9 L 7,9 L 7,3 Z M 3,3 L 3,1 L 9,1 L 9,7 L 7,7</Geometry>
        <Geometry x:Key="IconClose">M 1,1 L 9,9 M 9,1 L 1,9</Geometry>
        <Geometry x:Key="IconResize">M 8,0 L 8,8 M 4,4 L 8,8 M 0,8 L 8,8</Geometry>

        <!-- 窗体控制按钮基础样式 -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <!--强制允许点击，防止被 WindowChrome 的拖拽区域吞掉点击事件 -->
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Path x:Name="iconPath" 
                                  Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                  Stroke="{TemplateBinding Foreground}" 
                                  StrokeThickness="1.2" 
                                  Stretch="None"
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E8F0"/>
                                <Setter Property="Foreground" Value="#FF1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFCBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最大化按钮专用样式：根据窗口状态切换图标 -->
        <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Content" Value="{StaticResource IconMaximize}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="{StaticResource IconRestore}"/>
                    <Setter Property="ToolTip" Value="还原"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Normal">
                    <Setter Property="ToolTip" Value="最大化"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 关闭按钮样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEE4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFDC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 通用按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="WindowShadow" Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.15"/>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" Background="{StaticResource CardBrush}" CornerRadius="8" Effect="{StaticResource WindowShadow}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 默认状态：保留 8px 外边距给阴影 -->
                    <Setter Property="Margin" Value="8"/>
                    <Style.Triggers>
                        <!-- 最大化状态：移除外边距和圆角，填满屏幕 -->
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <!-- 最大化时不需要阴影 -->
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Title Bar -->
                <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                  
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="Arknights Bundle Converter" 
                                     FontSize="14" FontWeight="SemiBold" 
                                     Foreground="{StaticResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                            <Button x:Name="btnMinimize" Content="{StaticResource IconMinimize}" Style="{StaticResource ChromeButtonStyle}" Click="BtnMinimize_Click"/>
                            <Button x:Name="btnMaximize" Style="{StaticResource MaximizeButtonStyle}" Click="BtnMaximize_Click"/>
                            <Button x:Name="btnClose" Content="{StaticResource IconClose}" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Main Content Area -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input Section -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="输入源" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,12,0"/>
                    <TextBox x:Name="txtInputPaths" Grid.Row="0" Grid.Column="1" Height="36" Padding="6,8" IsReadOnly="True" Text="(未选择)" VerticalContentAlignment="Center" BorderBrush="#E2E8F0" TextChanged="txtInputPaths_TextChanged"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="btnSelectFiles" Content="单个文件" Style="{StaticResource OutlineButton}" Click="BtnSelectFiles_Click" Margin="0,0,6,0"/>
                        <Button x:Name="btnSelectInputDir" Content="选择目录" Style="{StaticResource OutlineButton}" Click="BtnSelectInputDir_Click"/>
                    </StackPanel>

                    <!-- Output Section -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="输出至" VerticalAlignment="Center" Foreground="#64748B" Margin="0,20,12,0"/>
                    <TextBox x:Name="txtOutputDir" Grid.Row="1" Grid.Column="1" Height="36" Margin="0,20,0,0" Padding="6,8" IsReadOnly="True" Text="(未选择)" VerticalContentAlignment="Center" BorderBrush="#E2E8F0"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="10,20,0,0">
                        <Button x:Name="btnSelectOutputDir" Content="选择目录" Style="{StaticResource OutlineButton}" Click="BtnSelectOutputDir_Click" Margin="0,0,6,0"/>
                        <Button x:Name="btnOpenOutput" Content="打开目录" Style="{StaticResource OutlineButton}" Click="BtnOpenOutput_Click"/>
                    </StackPanel>

                    <!-- Start Button -->
                    <Button x:Name="btnStart" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                            Content="开始转换" Height="44" FontSize="16" Margin="150,24,150,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnStart_Click"/>

                    <!-- Log Section -->
                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="执行日志" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtLog" Grid.Row="1" 
                                 FontFamily="Consolas" FontSize="13"
                                 Background="#F8FAFC" BorderThickness="1" BorderBrush="#E2E8F0"
                                 Padding="8"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>

                <!-- 3. Bottom Footer (Fixed) -->
                <Border Grid.Row="2" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Height="32" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                        </Grid.ColumnDefinitions>

                        <!-- Progress Bar -->
                        <Grid Margin="12,0">
                            <ProgressBar x:Name="progressBar" Height="6" BorderThickness="0" Background="#F1F5F9" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>

                        <!-- Percentage Text -->
                        <TextBlock x:Name="txtProgress" Grid.Column="1" 
                                   Text="0/0 (0%)" 
                                   FontSize="12" Foreground="#64748B" 
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <!-- Visual Resize Grip (纯视觉元素) -->
                        <Path Grid.Column="2" Data="M 10,10 L 4,10 L 10,4 Z" Fill="#CBD5E1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,5,5" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>